#!/bin/bash

CURRENT=$(gsettings get org.gnome.desktop.interface color-scheme)

if [[ "$CURRENT" == "'prefer-dark'" ]]; then                                          # Switch to LIGHT mode
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
    gsettings set org.gnome.desktop.interface gtk-theme 'Materia-light'
    notify-send -u low -i preferences-desktop-theme "Theme" "Switched to Light Mode"
else
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'              # Switch to DARK mode
    gsettings set org.gnome.desktop.interface gtk-theme 'Materia-dark'
    notify-send -u low -i preferences-desktop-theme "Theme" "Switched to Dark Mode"
fi
